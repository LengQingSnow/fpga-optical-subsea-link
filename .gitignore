# Runtime measurement data / histories are not published as default references.
/r_matlab/data/*
!/r_matlab/data/README.md
/r_matlab/data2/*
!/r_matlab/data2/README.md
/r_matlab/ref/
/r_matlab/tests_*/
/scripts/logs/
/scripts/outputs/
# Temporary exploration code is retained locally, excluded from public entry points.
/r_matlab/matlab/tmp_*.m
/r_matlab/matlab/query_scope_depth_tmp.m
/r_matlab/matlab/*.before_*.m

