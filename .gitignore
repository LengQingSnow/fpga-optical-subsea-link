*.elf
*.bin
*.xsa
*.hdf
*.mcs
*.prm
*.exe
*.dll
*.ltx
*.xpr
# Dataset payloads ARE source dependencies, not firmware output.
!code/ax7101/dataset/**/*.bin
!r_matlab/dataset2/**/*.bin
!code/ax7101/project/generated/dataset/**/*.bin
