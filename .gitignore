**/_ide/
*_sim_netlist.v
*_sim_netlist.vhdl
/code/ax7101/project/ip/[0-9a-f]/
**/ipshared/
**/reports/
/code/da_project/porject/vivado/output/archive/
/code/ax7101/project/generated/camera*/

# Never publish local credentials or tool licenses.
*.lic
*.pem
*.key
.env
.env.*

# Local legacy binaries, simulator caches and supplied competition guide.
/scripts/old/
**/xsim.dir/
/*.pdf
# Curated historical evidence and this packaging pass test logs.
!/build/evidence/**/*.rpt
!/build/evidence/**/*.log

# Eclipse/Vitis local histories are caches, not source inputs.
**/.metadata/
**/.recommenders/
